  "gradient": {
    "dark": {
      "gradient": {
        "top medium": {
          "gradientType": "linear",
          "rotation": 180,
          "stops": [
            {
              "position": 0,
              "color": "#181818ff"
            },
            {
              "position": 1,
              "color": "#18181833"
            }
          ]
        },
